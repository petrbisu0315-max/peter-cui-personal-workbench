{
  "name": "peter-cui-personal-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run",
    "check": "pnpm lint && pnpm test && pnpm build",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name peter-cui-workbench"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "oxlint": "1.86.0",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "^4.143.0"
  }
}
